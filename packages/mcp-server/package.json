{
  "name": "rag-mungil-mcp",
  "version": "1.0.0",
  "description": "Autonomous RAG-MUNGIL Model Context Protocol (MCP) Server for AI Agents",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "rag-mungil-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && chmod +x dist/cli.js",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
